{
  "name": "constructor-ai-task-manager-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t constructor-ai-task-manager .",
    "docker:run": "docker run --rm -p 3000:3000 -e DATABASE_PATH=/data/db.sqlite --memory=256m --cpus=0.5 constructor-ai-task-manager"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.1",
    "@types/supertest": "^2.0.12",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^1.4.6",
    "ts-node": "^10.9.1"
  }
}
